<?xml version="1.0" encoding="UTF-8"?>
<!--
  LinkOS — Thunar configuration
  Sets up single-click, hidden files visible, Fluent Dark toolbar.
-->
<channel name="thunar" version="1.0">
  <property name="misc-middle-click-in-tab" type="bool" value="true"/>
  <property name="misc-single-click" type="bool" value="true"/>
  <property name="misc-single-click-timeout" type="uint" value="250"/>
  <property name="misc-volume-management" type="bool" value="true"/>
  <property name="misc-case-sensitive" type="bool" value="false"/>
  <property name="misc-recursive-permissions" type="bool" value="true"/>
  <property name="misc-recursive-search" type="bool" value="true"/>
  <property name="misc-always-show-tabs" type="bool" value="false"/>
  <property name="misc-show-remote-thumbnails" type="bool" value="true"/>
  <property name="misc-thumbnail-max-files" type="uint" value="100"/>
  <property name="misc-parallel-copy-mode" type="bool" value="true"/>
  <property name="misc-image-size-in-statusbar" type="bool" value="true"/>
  <property name="misc-date-style" type="string" value="THUNAR_DATE_STYLE_SIMPLE"/>
  <property name="misc-folders-first" type="bool" value="true"/>
  <property name="misc-full-path-in-title" type="bool" value="false"/>
  <property name="misc-highlighting-enabled" type="bool" value="true"/>
  <property name="last-window-width" type="int" value="900"/>
  <property name="last-window-height" type="int" value="600"/>
  <property name="last-window-maximized" type="bool" value="false"/>
  <property name="last-details-view-zoom-level" type="string" value="THUNAR_ZOOM_LEVEL_38_PERCENT"/>
  <property name="last-icon-view-zoom-level" type="string" value="THUNAR_ZOOM_LEVEL_75_PERCENT"/>
  <property name="last-view" type="string" value="ThunarIconView"/>
  <property name="last-side-pane" type="string" value="ThunarShortcutsPane"/>
  <property name="last-sort-column" type="string" value="THUNAR_COLUMN_NAME"/>
  <property name="last-sort-order" type="string" value="GTK_SORT_ASCENDING"/>
  <property name="last-show-hidden" type="bool" value="false"/>
  <property name="last-statusbar-visible" type="bool" value="true"/>
  <property name="last-menubar-visible" type="bool" value="true"/>
  <property name="last-separator-position" type="int" value="180"/>
  <property name="last-preview-visible" type="bool" value="false"/>
  <property name="last-preview-split" type="int" value="200"/>
  <property name="last-go-to-path" type="string" value="/home/linkos"/>
  <property name="hidden-bookmarks" type="array"/>
  <property name="last-restore-tabs" type="array"/>
  <property name="last-restore-tabs-positions" type="array"/>
</channel>
