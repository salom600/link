# ============================================================================
# LinkOS — dunst notification daemon
# Fluent Dark styling for desktop notifications.
# ============================================================================

[global]
    # Display
    monitor = 0
    follow = mouse
    geometry = "400x5-30+30"
    indicate_hidden = yes
    shrink = no
    transparency = 15
    notification_height = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    frame_width = 0
    frame_color = "#4cc2ff"

    # Sort notifications
    sort = yes
    idle_threshold = 120

    # Fonts
    font = Cascadia Code 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Icons
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_path = /usr/share/icons/Fluent-Dark/32x32:/usr/share/icons/Adwaita/32x32

    # History
    sticky_history = yes
    history_length = 20

    # Misc
    dmenu = /usr/bin/rofi -dmenu -p dunst -theme linkos
    browser = /usr/bin/brave

    # Always run rule
    always_run_rules = true

    # Title
    title = Dunst
    class = Dunst

    # Startup notification
    startup_notification = false

    # Misc
    corner_radius = 8
    force_xinerama = false
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[urgency_low]
    background = "#1f1f1fee"
    foreground = "#e6e6e6ff"
    timeout = 5

[urgency_normal]
    background = "#2a2a2aee"
    foreground = "#e6e6e6ff"
    timeout = 10

[urgency_critical]
    background = "#e74c3cee"
    foreground = "#1f1f1fff"
    frame_color = "#e74c3c"
    timeout = 0
